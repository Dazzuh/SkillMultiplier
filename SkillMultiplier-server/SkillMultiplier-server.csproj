<Project Sdk="Microsoft.NET.Sdk.Web">

    <PropertyGroup>
        <SPTDir Condition="'$(SPTDir)' == ''">S:\SPT-Dev\4.1</SPTDir>
    </PropertyGroup>
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <RootNamespace>SkillMultiplier</RootNamespace>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <OutputType>Library</OutputType>
        <ModAuthor>Dazzuh</ModAuthor>
        <Version>2.0.0</Version>
        <OutputPath>bin\$(Configuration)\$(ProjectName)\$(AssemblyName)\</OutputPath>
        <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="SPTushonka.Common" Version="4.1.5" />
        <PackageReference Include="SPTushonka.DI" Version="4.1.5" />
        <PackageReference Include="SPTushonka.Server.Core" Version="4.1.5" />
    </ItemGroup>

    <PropertyGroup Condition="'$(Configuration)' == 'Release'">
        <DebugType>None</DebugType>
        <DebugSymbols>false</DebugSymbols>
        <GenerateDependencyFile>false</GenerateDependencyFile>
        <StaticWebAssetsEnabled>false</StaticWebAssetsEnabled>
    </PropertyGroup>

</Project>
